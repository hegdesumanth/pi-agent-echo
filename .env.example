# echo itself is provider-agnostic — it runs as extensions inside the `pi` CLI.
# These variables are only needed to manually test echo against a live model.
# Uncomment ONE of the lines below, or run `pi login` instead to use OAuth-based
# providers without an API key.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
